# Endereço público final do Arcadia. O HTTPS é obrigatório.
PUBLIC_BASE_URL=https://cryptominerarcadia.com
MANUAL_WITHDRAWALS_ENABLED=false

# Supabase Auth: estes dois valores identificam o projeto público.
# Nunca coloque SUPABASE_SECRET_KEY ou service_role no navegador.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
PUBLIC_LOGIN_ENABLED=false
# Enables the promoted workshop/seasonal mechanics in the selected deployment.
# Keep staging and production databases separate even when this is true.
ARCADIA_EXTENDED_GAMEPLAY_ENABLED=false
PUBLIC_INDEXING_ENABLED=false

# SHA-256 do e-mail verificado do fundador. Tratar como segredo do servidor.
ARCADIA_OWNER_ACCOUNT_ID=
ARCADIA_TRANSFER_SECRET=

# Proteção humana. A chave pública pode ir para o navegador; o segredo nunca.
# O segredo configurado no Supabase protege o Auth, mas também deve ser salvo
# separadamente como segredo do Worker para proteger os minigames.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=cryptominerarcadia.com
TURNSTILE_ALLOWED_HOSTNAMES=cryptominerarcadia.com,www.cryptominerarcadia.com
AUTH_CAPTCHA_REQUIRED=false
TURNSTILE_REQUIRED=false

# E-mail transacional. Sem domínio, google_apps_script serve somente ao beta.
# Com domínio, use resend. Segredos nunca devem aparecer no navegador.
TRANSACTIONAL_EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=Crypto Miner Arcadia <support@mail.arcadia.example>
SUPPORT_EMAIL_TO=support@arcadia.example
RESEND_API_KEY=
GOOGLE_MAIL_WEBHOOK_URL=
GOOGLE_MAIL_WEBHOOK_SECRET=

# Provedor de faturas. Chave de API e segredo IPN ficam apenas no servidor.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Produção: https://api.nowpayments.io/v1
# Sandbox: https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_API_BASE_URL=https://api-sandbox.nowpayments.io/v1
CRYPTO_DEPOSITS_ENABLED=false
CRYPTO_SANDBOX_ENABLED=false

# CCPayment (opcional; deixe desativado até validar o checkout no staging).
# App ID e App Secret devem ser configurados como secrets do Worker, nunca no
# navegador, em commits ou em arquivos .env versionados.
CCPAYMENT_ENABLED=false
CCPAYMENT_API_BASE_URL=https://admin.ccpayment.com/ccpayment/v1
# Caminho do Hosted Checkout v1. Mantenha a ativação separada até validar
# uma cobrança de teste no painel CCPayment.
CCPAYMENT_CHECKOUT_ENDPOINT=/bill/checkout
CCPAYMENT_CHECKOUT_ENABLED=false
CCPAYMENT_TESTNET_ENABLED=false
CCPAYMENT_APP_ID=
CCPAYMENT_APP_SECRET=
# Pix via Mercado Pago Checkout Transparente (Orders API).
# Comece em test e mantenha PIX_DEPOSITS_ENABLED=false até validar o webhook.
PIX_DEPOSITS_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=test
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# 300 = 3% de margem operacional visível na prévia do jogador.
PIX_OPERATIONAL_MARGIN_BPS=300

# Saques não possuem chave de ativação nesta fase.
