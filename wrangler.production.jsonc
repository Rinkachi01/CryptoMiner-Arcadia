{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crypto-miner-arcadia",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cryptominerarcadia.com",
      "custom_domain": true
    },
    {
      "pattern": "www.cryptominerarcadia.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crypto-miner-arcadia-production",
      "database_id": "ca81b9d2-167f-4b81-9d1a-2422cb09b04a",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECOVERY_ARCHIVE",
      "bucket_name": "crypto-miner-arcadia-recovery"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://cryptominerarcadia.com",
    "PUBLIC_INDEXING_ENABLED": "false",
    "SUPABASE_URL": "https://tgsofsumjyvrjohlghay.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_D-zur7SjizAWlwxf_0rD3Q_Xh7lJvrq",
    "PUBLIC_LOGIN_ENABLED": "true",
    "ARCADIA_EXTENDED_GAMEPLAY_ENABLED": "true",
    "PAYMENT_PROVIDER": "ccpayment",
    "CRYPTO_DEPOSITS_ENABLED": "true",
    "CRYPTO_LIVE_DEPOSITS_ENABLED": "true",
    "CRYPTO_LIVE_DEPOSITS_OWNER_ONLY": "false",
    "CRYPTO_SANDBOX_ENABLED": "false",
    "CCPAYMENT_ENABLED": "true",
    "CCPAYMENT_API_BASE_URL": "https://ccpayment.com/ccpayment/v2",
    "CCPAYMENT_CHECKOUT_ENDPOINT": "/createAppOrderDepositAddress",
    "CCPAYMENT_CHECKOUT_ENABLED": "true",
    "CCPAYMENT_CUSTOMER_FEE_BPS": "50",
    "CCPAYMENT_TESTNET_ENABLED": "false",
    "MANUAL_WITHDRAWALS_ENABLED": "true",
    "PIX_DEPOSITS_ENABLED": "true",
    "MERCADO_PAGO_ENVIRONMENT": "production",
    "MERCADO_PAGO_API_BASE_URL": "https://api.mercadopago.com",
    "PIX_OPERATIONAL_MARGIN_BPS": "300",
    "AUTH_CAPTCHA_REQUIRED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEEpj8fea0Bp_Y3_",
    "TURNSTILE_HOSTNAME": "cryptominerarcadia.com",
    "TURNSTILE_REQUIRED": "true",
    "EMAIL_PROVIDER": "google_apps_script",
    "GOOGLE_MAIL_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbxL3adoOmYzRwR0ylImzpPFI074_GQn2zIn58Rh_p3M3r6o2qtp-CYjKJarfgzPK_RlIA/exec",
    "SUPPORT_EMAIL_TO": "support@cryptominerarcadia.com",
    "TRANSACTIONAL_EMAIL_ENABLED": "true",
    "EMAIL_CYCLE_VERIFICATION_REQUIRED": "true"
  },
  "observability": {
    "enabled": true
  }
}
